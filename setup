#!/bin/bash

# =============================================
# CONFIGURATION AND VARIABLES
# =============================================

# Color definitions
green="\e[38;5;82m"
red="\e[38;5;196m"
neutral="\e[0m"
orange="\e[38;5;130m"
blue="\e[38;5;39m"
yellow="\e[38;5;226m"
purple="\e[38;5;141m"
bold_white="\e[1;37m"
pink="\e[38;5;205m"
reset="\e[0m"
gray="\e[38;5;245m"

sysctl -w net.ipv6.conf.all.disable_ipv6=1 >/dev/null 2>&1
sysctl -w net.ipv6.conf.default.disable_ipv6=1 >/dev/null 2>&1
# Repository base URL
REPO="https://raw.githubusercontent.com/PeyxDev/scripttun/main"

# System information
timezone="Asia/Jakarta"
domain=""
ip=$(wget -qO- ipinfo.io/ip)

# URL definitions
nginx_key_url="https://nginx.org/keys/nginx_signing.key"
dropbear_init_url="${REPO}/project/dropbear/dropbear"
dropbear_conf_url="${REPO}/project/examples/dropbear"
dropbear_dss_url="${REPO}/project/dropbear/dropbear_dss_host_key"
sshd_conf_url="${REPO}/project/examples/sshd"
banner_url="${REPO}/project/examples/banner"
common_password_url="${REPO}/project/examples/common-password"
ins_sshws_url="${REPO}/project/sshws/insshws.sh"
ohpserver="${REPO}/project/sshws/ohp.sh"
gotop_url="${REPO}/project/gotop/gotop"
haproxy_cfg_url="${REPO}/project/Haproxy/haproxy.cfg"
xray_conf_url="${REPO}/project/Xray/xray.conf"
udp_url="${REPO}/project/udp/udp-custom.sh"
nginx_conf_url="${REPO}/project/nginx/nginx.conf"
badvpn_url="${REPO}/project/BadVPN-UDPGW/badvpn"
openvpn_url="${REPO}/project/openvpn/openvpn.zip"
api_url="${REPO}/project/api/api-px.sh"

# =============================================
# FUNCTIONS
# =============================================

print_rainbow() {
    local text="$1"
    local length=${#text}
    local start_color=(0 5 0)
    local mid_color=(0 200 0)
    local end_color=(0 5 0)
    for ((i = 0; i < length; i++)); do
        local progress=$((i * 100 / (length - 1)))
        if [ $progress -lt 50 ]; then
            local factor=$((progress * 2))
            r=$(((start_color[0] * (100 - factor) + mid_color[0] * factor) / 100))
            g=$(((start_color[1] * (100 - factor) + mid_color[1] * factor) / 100))
            b=$(((start_color[2] * (100 - factor) + mid_color[2] * factor) / 100))
        else
            local factor=$(((progress - 50) * 2))
            r=$(((mid_color[0] * (100 - factor) + end_color[0] * factor) / 100))
            g=$(((mid_color[1] * (100 - factor) + end_color[1] * factor) / 100))
            b=$(((mid_color[2] * (100 - factor) + end_color[2] * factor) / 100))
        fi
        printf "\e[38;2;%d;%d;%dm%s" "$r" "$g" "$b" "${text:$i:1}"
    done
    echo -e "$reset"
}

loading_bar() {
    local total=$1
    local current=0
    local width=50
    local filled="▰"
    local empty="▱"

    while [ "$current" -le "$total" ]; do
        local filled_count=$((current * width / total))
        local empty_count=$((width - filled_count))
        local bar=$(printf "%${filled_count}s" | tr ' ' "$filled")
        bar+=$(printf "%${empty_count}s" | tr ' ' "$empty")
        printf "\r[${bar}] %d%%" $((current * 100 / total))
        sleep 0.1
        ((current++))
    done
    printf "\n"
}

log_success() {
    echo -e "${green}✓ $1${neutral}"
}

log_error() {
    echo -e "${red}✗ $1${neutral}"
}

log_warning() {
    echo -e "${yellow}⚠ $1${neutral}"
}

log_info() {
    echo -e "${blue}ℹ $1${neutral}"
}

download_file() {
    local url="$1"
    local output="$2"
    local description="$3"
    
    if wget -O "$output" "$url" >/dev/null 2>&1; then
        log_success "Successfully downloaded $description"
        return 0
    else
        log_error "Failed to download $description"
        return 1
    fi
}

download_and_chmod() {
    local url="$1"
    local output="$2"
    local description="$3"
    
    if download_file "$url" "$output" "$description"; then
        chmod +x "$output" >/dev/null 2>&1
        return 0
    fi
    return 1
}

check_command() {
    if command -v "$1" >/dev/null 2>&1; then
        return 0
    else
        return 1
    fi
}

install_package() {
    local package="$1"
    if dpkg -s "$package" >/dev/null 2>&1; then
        log_info "$package is already installed, skipping..."
        return 0
    else
        if apt-get install -y "$package" >/dev/null 2>&1; then
            log_success "Successfully installed $package"
            return 0
        else
            log_error "Failed to install $package"
            return 1
        fi
    fi
}

# =============================================
# LICENSE VERIFICATION
# =============================================

verify_license() {
    log_info "Memverifikasi lisensi VPS..."

    local izin_data
    izin_data=$(curl -s "${REPO}/izin")

    if [ -z "$izin_data" ] || ! echo "$izin_data" | grep -q "$ip"; then
        clear
        echo -e "${red}────────────────────────────────────────────${neutral}"
        echo -e "${red}           PERMISSION DENIED !${neutral}"
        echo -e "${red}────────────────────────────────────────────${neutral}"
        echo -e "${yellow}  IP VPS Anda: ${bold_white}$ip${neutral}"
        echo -e "${yellow}  IP ini tidak terdaftar / tidak memiliki izin instalasi.${neutral}"
        echo -e "${red}────────────────────────────────────────────${neutral}"
        echo -e "${yellow}  Silakan hubungi admin untuk mendapatkan akses:${neutral}"
        echo -e "     ${green}WhatsApp${neutral} wa.me/6283151636921"
        echo -e "     ${blue}Telegram${neutral} t.me/frel01"
        echo -e "${red}────────────────────────────────────────────${neutral}"
        exit 1
    fi

    log_success "Lisensi terverifikasi untuk IP $ip"
}

# =============================================
# INITIAL SETUP
# =============================================

initial_setup() {
    clear
    
    # Create required directories
    log_info "Creating required directories..."
    local directories=(
        /run/xray
        /etc/xray
        /etc/peyx
        /etc/peyx/limit/vmess/ip
        /etc/peyx/limit/vless/ip
        /etc/peyx/limit/trojan/ip
        /var/log/xray
        /var/www/html
        /home/vps/public_html
        /etc/haproxy
    )

    for dir in "${directories[@]}"; do
        [ ! -d "$dir" ] && mkdir -p "$dir"
        chmod 777 "$dir"
    done

    # www-data needs to own the xray domain socket dir, same as ins-xray.sh expects
    chown www-data:www-data /run/xray >/dev/null 2>&1

    # Domain setup
    if [ -z "$1" ]; then
        echo -e "${blue}    ┌───────────────────────────────────────────────┐${neutral}"
        echo -e "${blue}    │   ${green}┌─┐┬ ┬┌┬┐┌─┐┌─┐┌─┐┬─┐┬┌─┐┌┬┐ ${neutral}"
        echo -e "${blue}    │   ${green}├─┤│ │ │ │ │└─┐│  ├┬┘│├─┘ │  ${neutral}"
        echo -e "${blue}    │   ${green}┴ ┴└─┘ ┴ └─┘└─┘└─┘┴└─┴┴   ┴  ${neutral}"
        echo -e "${blue}    │   ${yellow}Copyright${reset} (C)${gray} https://t.me/frel01   ${neutral}"
        echo -e "${blue}    └───────────────────────────────────────────────┘${neutral}"
        echo -e "${blue}    ────────────────────────────────────────────────${neutral}"
        echo -e "${yellow}     Masukkan domain Anda untuk memulai instalasi:${neutral}"
        echo -e "${blue}    ────────────────────────────────────────────────${neutral}"
        read -p "  Enter your domain: " domain
    else
        domain="$1"
    fi

    # Validate domain
    log_info "Validating domain..."
    vps_ip=$(curl -s ipinfo.io/ip)
    domain_ip=$(getent ahosts "$domain" | awk '{print $1}' | head -n 1)
    
    if [ "$domain_ip" != "$vps_ip" ]; then
        log_error "Domain is not connected to the VPS IP. Please check again."
        exit 1
    fi

    # Save domain to file
    echo "$domain" >/etc/xray/domain
    log_success "Domain $domain validated and saved"

    # Create required files
    local files=(
        /etc/xray/domain
        /var/log/xray/access.log
        /var/log/xray/error.log
        /var/log/xray/access2.log
        /var/log/xray/error2.log
        /etc/ssh/.ssh.db
    )

    for file in "${files[@]}"; do
        [ ! -f "$file" ] && touch "$file"
        chmod 777 "$file"
    done

    # Set execute permissions
    chmod +x /var/log/xray /etc/xray /etc/haproxy /etc/peyx /etc/peyx/limit/vmess/ip /etc/peyx/limit/vless/ip /etc/peyx/limit/trojan/ip

    # Save system information
    city=$(curl -s ipinfo.io/city)
    isp=$(curl -s ipinfo.io/org | cut -d " " -f 2-10)
    
    [ -f /etc/xray/city ] && rm /etc/xray/city
    echo "${city:-"City information not available"}" >>/etc/xray/city
    
    [ -f /etc/xray/isp ] && rm /etc/xray/isp
    echo "${isp:-"ISP information not available"}" >>/etc/xray/isp
}

# =============================================
# SYSTEM PREPARATION
# =============================================

system_preparation() {
    log_info "Starting system preparation..."
    
    # Check root privileges
    if [ "$EUID" -ne 0 ]; then
        log_error "This script must be run as root"
        exit 1
    fi

    # Detect OS
    os_id=$(grep -w ID /etc/os-release | head -n1 | sed 's/ID=//g' | sed 's/"//g')
    os_version=$(grep -w VERSION_ID /etc/os-release | head -n1 | sed 's/VERSION_ID=//g' | sed 's/"//g')
    log_info "Detected OS: $os_id $os_version"

    # Update system
    log_info "Updating package lists..."
    if ! apt update -y >/dev/null 2>&1; then
        log_error "Failed to update package lists"
    fi

    # Install essential packages
    log_info "Installing essential packages..."
    local essential_packages=(
        sudo
        software-properties-common
        debconf-utils
    )

    for package in "${essential_packages[@]}"; do
        install_package "$package"
    done

    # Remove conflicting packages
    log_info "Removing conflicting packages..."
    local conflicting_packages=(
        exim4
        ufw
        firewalld
    )

    for package in "${conflicting_packages[@]}"; do
        if dpkg -s "$package" >/dev/null 2>&1; then
            if apt remove --purge -y "$package" >/dev/null 2>&1; then
                log_success "Removed $package"
            else
                log_error "Failed to remove $package"
            fi
        fi
    done

    # Configure debconf
    log_info "Configuring system settings..."
    echo iptables-persistent iptables-persistent/autosave_v4 boolean true | debconf-set-selections
    echo iptables-persistent iptables-persistent/autosave_v6 boolean true | debconf-set-selections
    debconf-set-selections <<<"keyboard-configuration keyboard-configuration/layout select English"
    debconf-set-selections <<<"keyboard-configuration keyboard-configuration/variant select English"

    export DEBIAN_FRONTEND=noninteractive

    # System upgrade
    log_info "Upgrading system..."
    apt-get upgrade -y >/dev/null 2>&1 && log_success "System upgraded" || log_error "Failed to upgrade system"
    apt dist-upgrade -y >/dev/null 2>&1 && log_success "System dist-upgraded" || log_error "Failed to dist-upgrade system"
}

# =============================================
# PACKAGE INSTALLATION
# =============================================

package_installation() {
    log_info "Installing required packages..."
    
    local packages=(
        libnss3-dev liblzo2-dev libnspr4-dev pkg-config libpam0g-dev libcap-ng-dev
        libcap-ng-utils libselinux1-dev flex bison make libnss3-tools libevent-dev bc
        rsyslog dos2unix zlib1g-dev libssl-dev libsqlite3-dev sed dirmngr libxml-parser-perl build-essential
        gcc g++ htop lsof tar wget curl ruby zip unzip p7zip-full libc6 util-linux
        ca-certificates iptables iptables-persistent netfilter-persistent
        net-tools openssl gnupg gnupg2 lsb-release shc cmake git whois
        screen socat xz-utils apt-transport-https gnupg1 dnsutils cron bash-completion ntpdate chrony jq
        tmux python3 python3-pip lsb-release gawk
        libncursesw5-dev libgdbm-dev tk-dev libffi-dev libbz2-dev checkinstall
        openvpn easy-rsa dropbear
    )

    for package in "${packages[@]}"; do
        install_package "$package"
    done

    # Install Node.js if not exists
    if ! check_command nodejs; then
        log_info "Installing Node.js..."
        curl -fsSL https://deb.nodesource.com/setup_20.x | sudo -E bash - >/dev/null 2>&1
        install_package nodejs
        npm install -g npm@latest >/dev/null 2>&1
    else
        log_info "Node.js is already installed"
    fi

    # Install vnstat
    if ! check_command vnstat; then
        log_info "Installing vnstat..."
        install_package vnstat
        # Additional vnstat configuration
        net=$(ip -4 route ls | grep default | grep -Po '(?<=dev )(\S+)' | head -1)
        vnstat -i $net
        systemctl enable vnstat >/dev/null 2>&1
        systemctl start vnstat >/dev/null 2>&1
    fi

    # Set timezone
    ln -fs /usr/share/zoneinfo/$timezone /etc/localtime
}

# =============================================
# WEB SERVER INSTALLATION
# =============================================

web_server_installation() {
    log_info "Installing web servers..."
    
    os_id=$(grep -w ID /etc/os-release | head -n1 | sed 's/ID=//g' | sed 's/"//g')
    
    if [[ $os_id == "ubuntu" ]]; then
        log_info "Installing nginx for Ubuntu..."
        install_package software-properties-common
        rm -f /etc/apt/sources.list.d/nginx.list >/dev/null 2>&1
        install_package ubuntu-keyring
        
        curl -fsSL $nginx_key_url | gpg --dearmor | tee /usr/share/keyrings/nginx-archive-keyring.gpg >/dev/null
        echo "deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] http://nginx.org/packages/ubuntu $(lsb_release -cs) nginx" | tee /etc/apt/sources.list.d/nginx.list
        echo -e "Package: *\nPin: origin nginx.org\nPin: release o=nginx\nPin-Priority: 900\n" | tee /etc/apt/preferences.d/99nginx
        
        apt update -y >/dev/null 2>&1
        install_package nginx
        
        [ -f /etc/nginx/conf.d/default.conf ] && rm /etc/nginx/conf.d/default.conf
        
    elif [[ $os_id == "debian" ]]; then
        log_info "Installing nginx for Debian..."
        rm -f /etc/apt/sources.list.d/nginx.list >/dev/null 2>&1
        install_package debian-archive-keyring
        
        curl -fsSL $nginx_key_url | gpg --dearmor | tee /usr/share/keyrings/nginx-archive-keyring.gpg >/dev/null
        echo "deb [signed-by=/usr/share/keyrings/nginx-archive-keyring.gpg] http://nginx.org/packages/debian $(lsb_release -cs) nginx" | tee /etc/apt/sources.list.d/nginx.list
        echo -e "Package: *\nPin: origin nginx.org\nPin: release o=nginx\nPin-Priority: 900\n" | tee /etc/apt/preferences.d/99nginx
        
        apt update -y >/dev/null 2>&1
        install_package nginx
    else
        log_error "Unsupported OS: $os_id"
        exit 1
    fi

    # Install HAProxy based on OS version
    install_haproxy
}

install_haproxy() {
    log_info "Installing HAProxy..."
    
    case "$os_id-$os_version" in
        "ubuntu-18.04")
            add-apt-repository -y ppa:vbernat/haproxy-2.6 >/dev/null 2>&1
            apt update -y >/dev/null 2>&1
            apt-get install -y haproxy=2.6.* >/dev/null 2>&1
            ;;
        "ubuntu-20.04")
            add-apt-repository -y ppa:vbernat/haproxy-2.9 >/dev/null 2>&1
            apt update -y >/dev/null 2>&1
            apt-get install -y haproxy=2.9.* >/dev/null 2>&1
            ;;
        "ubuntu-22.04"|"ubuntu-24.04")
            add-apt-repository -y ppa:vbernat/haproxy-3.0 >/dev/null 2>&1
            apt update -y >/dev/null 2>&1
            apt-get install -y haproxy=3.0.* >/dev/null 2>&1
            ;;
        "debian-10")
            curl -fsSL https://haproxy.debian.net/bernat.debian.org.gpg | gpg --dearmor >/usr/share/keyrings/haproxy.debian.net.gpg
            echo deb "[signed-by=/usr/share/keyrings/haproxy.debian.net.gpg]" http://haproxy.debian.net buster-backports-2.6 main >/etc/apt/sources.list.d/haproxy.list
            apt update -y >/dev/null 2>&1
            apt-get install -y haproxy=2.6.* >/dev/null 2>&1
            ;;
        "debian-11")
            curl -fsSL https://haproxy.debian.net/bernat.debian.org.gpg | gpg --dearmor >/usr/share/keyrings/haproxy.debian.net.gpg
            echo deb "[signed-by=/usr/share/keyrings/haproxy.debian.net.gpg]" http://haproxy.debian.net bullseye-backports-3.0 main >/etc/apt/sources.list.d/haproxy.list
            apt update -y >/dev/null 2>&1
            apt-get install -y haproxy=3.0.* >/dev/null 2>&1
            ;;
        "debian-12")
            curl -fsSL https://haproxy.debian.net/bernat.debian.org.gpg | gpg --dearmor >/usr/share/keyrings/haproxy.debian.net.gpg
            echo deb "[signed-by=/usr/share/keyrings/haproxy.debian.net.gpg]" http://haproxy.debian.net bookworm-backports-3.0 main >/etc/apt/sources.list.d/haproxy.list
            apt update -y >/dev/null 2>&1
            apt-get install -y haproxy=3.0.* >/dev/null 2>&1
            ;;
        *)
            log_error "Unsupported OS version for HAProxy"
            exit 1
            ;;
    esac
    
    log_success "HAProxy installed successfully"
}

# =============================================
# MENU AND TOOLS DOWNLOAD
# =============================================

download_menu_tools() {
    log_info "Downloading menu and tools..."
    
    echo "Memulai proses instalasi, mohon tunggu..."
    loading_bar 100

    mkdir -p /etc/menu
    cd /etc/menu

    url="${REPO}/menu/menu.zip"
    
    if wget -O menu.zip "$url" >/dev/null 2>&1; then
        7z e -pPX menu.zip >/dev/null 2>&1
        rm -f menu.zip >/dev/null 2>&1

        # Convert all extracted files to Unix line endings
        if check_command dos2unix; then
            find . -type f -exec dos2unix {} \; >/dev/null 2>&1
        else
            find . -type f -exec sed -i 's/\r$//' {} \; >/dev/null 2>&1
        fi

        chmod +x * >/dev/null 2>&1
        mkdir -p /usr/local/sbin
        mv * /usr/local/sbin >/dev/null 2>&1
        cd /
        rm -rf /etc/menu >/dev/null 2>&1
        log_success "Menu tools downloaded and installed"
    else
        log_error "Failed to download menu tools"
    fi

    echo "Proses instalasi selesai."
}

# =============================================
# CONFIGURATION FILES DOWNLOAD
# =============================================

download_configurations() {
    log_info "Downloading configuration files..."
    
    # Download SSH configurations
    download_file "$dropbear_conf_url" "/etc/default/dropbear" "dropbear configuration"
    download_and_chmod "$dropbear_init_url" "/etc/init.d/dropbear" "dropbear init script"
    download_and_chmod "$dropbear_dss_url" "/etc/dropbear/dropbear_dss_host_key" "dropbear DSS host key"
    
    download_file "$sshd_conf_url" "/etc/ssh/sshd_config" "SSH configuration"
    download_and_chmod "$banner_url" "/etc/peyx.txt" "banner file"
    download_file "$common_password_url" "/etc/pam.d/common-password" "common-password configuration"

    # Download proxy tools - FIXED: Separate files for ws.py and ohp
    download_and_chmod "$ins_sshws_url" "/usr/bin/ws" "ws"
    download_and_chmod "$ohpserver" "/usr/bin/ohp" "ohp"

    # Download gotop
    if download_and_chmod "$gotop_url" "/usr/bin/gotop" "gotop"; then
        if check_command dos2unix; then
            dos2unix /usr/bin/gotop >/dev/null 2>&1
        else
            sed -i 's/\r$//' /usr/bin/gotop
        fi
    else
        log_warning "Trying alternative gotop source..."
        if wget -O /usr/bin/gotop "https://github.com/xxxserxxx/gotop/releases/download/v4.2.0/gotop_v4.2.0_linux_amd64.deb" >/dev/null 2>&1; then
            dpkg -i /usr/bin/gotop >/dev/null 2>&1 && log_success "Gotop installed from alternative source"
        fi
    fi

    # Remove existing haproxy config and apache
    [ -f /etc/haproxy/haproxy.cfg ] && rm /etc/haproxy/haproxy.cfg && log_info "Existing haproxy.cfg removed"
    
    if dpkg -s apache2 >/dev/null 2>&1; then
        apt-get remove --purge apache2 -y >/dev/null 2>&1 && log_info "Apache removed"
    else
        log_info "Apache not installed, skipping removal"
    fi

    # Download service configurations
    download_file "$haproxy_cfg_url" "/etc/haproxy/haproxy.cfg" "haproxy configuration"
    download_file "$xray_conf_url" "/etc/nginx/conf.d/xray.conf" "xray nginx configuration"
    download_file "$nginx_conf_url" "/etc/nginx/nginx.conf" "nginx configuration" && chmod +x /etc/nginx/nginx.conf

    # Download UDP and BadVPN - FIXED: Complete URL for udp-custom
    download_and_chmod "$udp_url" "/usr/bin/udp" "udp-custom"
    download_and_chmod "$badvpn_url" "/usr/bin/badvpn" "badvpn"
}

# =============================================
# NETWORK AND SECURITY CONFIGURATION
# =============================================

network_configuration() {
    log_info "Configuring network and security..."
    
    # Install and configure BBR
    wget --no-check-certificate -O /opt/bbr.sh ${REPO}/project/examples/bbr.sh >/dev/null 2>&1
    chmod 755 /opt/bbr.sh
    /opt/bbr.sh

    # Configure iptables rules
    interface=$(ip -4 route ls | grep default | grep -Po '(?<=dev )(\S+)' | head -1)
    
    iptables -t nat -A PREROUTING -i $interface -p udp -m udp --dport 53 -j REDIRECT --to-ports 5300
    iptables -t nat -A POSTROUTING -s 10.8.0.0/24 -o $interface -j MASQUERADE
    iptables -t nat -A POSTROUTING -s 20.8.0.0/24 -o $interface -j MASQUERADE
    
    iptables-save >/etc/iptables/rules.v4
    log_success "iptables rules configured"

    # Enable IP forwarding
    if ! grep -q "^net.ipv4.ip_forward=1" /etc/sysctl.conf; then
        echo "net.ipv4.ip_forward=1" >>/etc/sysctl.conf
    fi
    sysctl -p >/dev/null 2>&1
}

# =============================================
# API INSTALLATION
# =============================================

api_installation() {
    log_info "Installing API service..."

    local api_script="/tmp/api-px.sh"

    if download_and_chmod "$api_url" "$api_script" "API installer"; then
        bash "$api_script"
        if systemctl is-active --quiet api.service; then
            log_success "API service installed and running (port 8585)"
        else
            log_warning "API service installed but not running, check: systemctl status api"
        fi
        rm -f "$api_script"
    else
        log_error "Failed to download API installer"
    fi
}

# =============================================
# OPENVPN CONFIGURATION
# =============================================

openvpn_configuration() {
    log_info "Configuring OpenVPN..."
    
    mkdir -p /usr/lib/openvpn/
    [ ! -d "/etc/openvpn/" ] && mkdir -p /etc/openvpn/

    # Download and extract OpenVPN configuration
    if download_file "$openvpn_url" "/etc/openvpn/openvpn.zip" "OpenVPN configuration"; then
        if unzip -d /etc/openvpn/ /etc/openvpn/openvpn.zip >/dev/null 2>&1; then
            rm -f /etc/openvpn/openvpn.zip
            log_success "OpenVPN configuration extracted"
        else
            log_error "Failed to extract OpenVPN configuration"
        fi
    fi

    # Create OpenVPN client configurations
    create_openvpn_clients
}

create_openvpn_clients() {
    log_info "Creating OpenVPN client configurations..."
    
    cat >/etc/openvpn/client-tcp.ovpn <<EOF
auth-user-pass
client
dev tun
proto tcp
remote $ip 1194
persist-key
persist-tun
pull
resolv-retry infinite
nobind
user nobody
comp-lzo
remote-cert-tls server
verb 3
mute 2
connect-retry 5 5
connect-retry-max 8080
mute-replay-warnings
redirect-gateway def1
script-security 2
cipher none
auth none
EOF

    cat >/etc/openvpn/client-udp.ovpn <<EOF
auth-user-pass
client
dev tun
proto udp
remote $ip 2200
persist-key
persist-tun
pull
resolv-retry infinite
nobind
user nobody
comp-lzo
remote-cert-tls server
verb 3
mute 2
connect-retry 5 5
connect-retry-max 8080
mute-replay-warnings
redirect-gateway def1
script-security 2
cipher none
auth none
EOF

    cat >/etc/openvpn/client-ssl.ovpn <<EOF
auth-user-pass
client
dev tun
proto tcp
remote $ip 443
persist-key
persist-tun
pull
resolv-retry infinite
nobind
user nobody
comp-lzo
remote-cert-tls server
verb 3
mute 2
connect-retry 5 5
connect-retry-max 8080
mute-replay-warnings
redirect-gateway def1
script-security 2
cipher none
auth none
EOF

    # Add certificates to client configs
    for config in client-tcp client-udp client-ssl; do
        echo '<ca>' >>/etc/openvpn/${config}.ovpn
        cat /etc/openvpn/ca.crt >>/etc/openvpn/${config}.ovpn
        echo '</ca>' >>/etc/openvpn/${config}.ovpn
        cp /etc/openvpn/${config}.ovpn /var/www/html/${config}.ovpn
    done

    # Create zip file with all configurations
    cd /var/www/html/
    zip -j allovpn.zip client-tcp.ovpn client-udp.ovpn client-ssl.ovpn >/dev/null 2>&1
    sed -i 's/#AUTOSTART="all"/AUTOSTART="all"/g' /etc/default/openvpn
    cd
    
    log_success "OpenVPN client configurations created"
}

# =============================================
# SYSTEM SERVICE CONFIGURATION
# =============================================

service_configuration() {
    log_info "Configuring system services..."
    
    # Create JSON configuration
    cat >/usr/bin/config.json <<EOF
{
"listen": ":2100",
"stream_buffer": 33554432,
"receive_buffer": 83886080,
"auth": {
"mode": "passwords"
}
}
EOF

    # Configure cron jobs
    configure_cron_jobs
    
    # Configure shell environment
    configure_shell
    
    # Create systemd services
    create_systemd_services
    
    # Setup bot
    setup_bot
    
    # Add swap
    setup_swap
}

configure_cron_jobs() {
    cat >/etc/cron.d/xp_all <<EOF
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
2 0 * * * root /usr/local/sbin/exp
EOF

    cat >/etc/cron.d/daily_reboot <<EOF
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
0 5 * * * root /sbin/reboot
EOF

    cat >/etc/cron.d/logclear <<EOF
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
0 */6 * * * root /usr/local/sbin/logclear
EOF

    service cron restart >/dev/null 2>&1
    echo "5" >/home/daily_reboot
}

configure_shell() {
    cat >/root/.profile <<EOF
if [ "\$BASH" ]; then
if [ -f ~/.bashrc ]; then
. ~/.bashrc
fi
fi
mesg n || true
menu
EOF
    chmod 644 /root/.profile

    cat >/root/.bashrc <<EOF
cat /dev/null > ~/.bash_history && history -c
EOF
    chmod 644 /root/.bashrc

    cat >/etc/shells <<EOF
/bin/sh
/bin/bash
/usr/bin/bash
/bin/rbash
/usr/bin/rbash
/bin/dash
/usr/bin/dash
/usr/bin/screen
/usr/bin/tmux
/bin/false
/usr/sbin/nologin
EOF
    chmod +x /etc/shells

    cat /dev/null >~/.bash_history && history -c
}

create_systemd_services() {
    local capabilities="CAP_NET_ADMIN CAP_NET_BIND_SERVICE"
    local limits="LimitNPROC=10000\nLimitNOFILE=1000000"
    local restart="Restart=on-failure\nRestartPreventExitStatus=23"
    local wanted_by="WantedBy=multi-user.target"
    local after="After=network.target nss-lookup.target"
    local documentation="Documentation=https://t.me/frel01"

    # Xray services
    create_xray_service "vmess" "/usr/local/bin/xray run -config /etc/xray/vmess/%i.json"
    create_xray_service "vless" "/usr/local/bin/xray run -config /etc/xray/vless/%i.json"
    create_xray_service "trojan" "/usr/local/bin/xray run -config /etc/xray/trojan/%i.json"
    create_xray_service "shadowsocks" "/usr/local/bin/xray run -config /etc/xray/shadowsocks/%i.json"

    # Other services
    create_generic_service "ws" "Python Proxy PeyxDev" " /usr/bin/ws"
    create_generic_service "udp" "ePro Udp-Custom VPN Server" "/usr/bin/udp server -exclude 2200,7300,7200,7100,323,10008,10004 /usr/bin/config.json"
    create_generic_service "limitip" "Limit IP Usage Xray Service" "/bin/bash -c '/usr/local/sbin/limitipssh 15 & /usr/local/sbin/limitip 15 & wait'"
    create_generic_service "limitquota" "Limit Quota Usage Xray Service" "/usr/local/sbin/quota"
    create_generic_service "badvpn" "BadVPN UDP Service" "/usr/bin/badvpn --listen-addr 127.0.0.1:7100 --listen-addr 127.0.0.1:7200 --listen-addr 127.0.0.1:7300 --max-clients 500"

    # Configure xray single config
    mkdir -p /etc/systemd/system/xray@.service.d/
    cat >/etc/systemd/system/xray@.service.d/10-donot_touch_single_conf.conf <<EOF
[Service]
ExecStart=
ExecStart=/usr/local/bin/xray run -config /etc/xray/%i.json
EOF

    # Reload systemd and restart services
    systemctl daemon-reload
    systemctl stop xray >/dev/null 2>&1
    systemctl disable xray >/dev/null 2>&1
    
    # Restart dropbear
    systemctl disable dropbear >/dev/null 2>&1
    systemctl stop dropbear >/dev/null 2>&1
    rm -rf /lib/systemd/system/dropbear.service >/dev/null 2>&1
    systemctl daemon-reload
    /etc/init.d/dropbear start
    /etc/init.d/dropbear restart
}

create_xray_service() {
    local name=$1
    local exec_start=$2
    
    cat >/etc/systemd/system/${name}@config.service <<EOF
[Unit]
Description=GerhanaTunnel Server Xray Instance %i
Documentation=https://t.me/frel01
After=network.target nss-lookup.target

[Service]
User=www-data
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ExecStart=$exec_start
Restart=on-failure
RestartPreventExitStatus=23
LimitNPROC=10000
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
EOF
}

create_generic_service() {
    local name=$1
    local description=$2
    local exec_start=$3
    
    cat >/etc/systemd/system/${name}.service <<EOF
[Unit]
Description=$description
Documentation=https://t.me/frel01
After=network.target nss-lookup.target

[Service]
Type=simple
User=root
NoNewPrivileges=true
ExecStart=$exec_start
Restart=on-failure
RestartPreventExitStatus=23
LimitNPROC=10000
LimitNOFILE=1000000

[Install]
WantedBy=multi-user.target
EOF
}

setup_swap() {
    log_info "Setting up swap file..."
    
    local swap_file="/swapfile"
    local swap_size="5G"
    
    if [ ! -f "$swap_file" ]; then
        fallocate -l $swap_size $swap_file
        chmod 600 $swap_file
        mkswap $swap_file >/dev/null 2>&1
        swapon $swap_file
        echo "$swap_file swap swap defaults 0 0" >> /etc/fstab
        log_success "Swap RAM successfully added with size $swap_size"
    else
        log_info "Swap file already exists"
    fi
}

# =============================================
# FINAL SETUP AND CLEANUP
# =============================================

final_setup() {
    log_info "Performing final setup..."
    
    # Save license key
    data=$(curl -s ${REPO}/izin)
    key=$(echo "$data" | grep "$ip" | awk '{print $2}')
    
    if [ -f /root/.key ]; then
        rm -f /root/.key
    fi
    echo "$key" >>/root/.key

    # Install express for menu
    npm i --prefix /usr/bin express express-fileupload >/dev/null 2>&1

    # Start all services
    start_services

    # Cleanup
    if [ -d "/root/rmck" ]; then
        rm -rf /root/rmck
    fi
}

start_services() {
    log_info "Starting all services..."
    
    local services=(
        "vmess@config.service"
        "vless@config.service"
        "trojan@config.service"
        "shadowsocks@config.service"
        "haproxy.service"
        "ws.service"
        "udp.service"
        "limitip.service"
        "limitquota.service"
        "badvpn.service"
        "nginx.service"
        "ssh.service"
        "dropbear.service"
        "api.service"
    )

    for service in "${services[@]}"; do
        systemctl enable $service >/dev/null 2>&1
        systemctl start $service >/dev/null 2>&1
        systemctl restart $service >/dev/null 2>&1
        echo -ne "Restarting $service...\r"
        sleep 1
        echo -ne "Restarting $service...${green} Done! ${neutral}\n"
    done

    systemctl restart netfilter-persistent >/dev/null 2>&1
}

# =============================================
# MAIN EXECUTION
# =============================================

main() {
    echo -e "${blue}=========================================${neutral}"
    echo -e "${green}       SCRIPT INSTALLATION VIP          ${neutral}"
    echo -e "${blue}=========================================${neutral}"
    
    # Verify license before doing anything else
    verify_license

    # Execute all steps in sequence
    initial_setup "$1"
    system_preparation
    package_installation
    web_server_installation
    download_menu_tools
    download_configurations
    network_configuration
    api_installation
    openvpn_configuration
    service_configuration
    final_setup
    
    # Completion message
    clear
    echo -e "${blue}─────────────────────────────────────────${neutral}"
    echo -e "${green}           INSTALLASI SELESAI            ${neutral}"
    echo -e "${blue}─────────────────────────────────────────${neutral}"
    echo -e "${green}  Selamat! Proses instalasi selesai.${neutral}"
    echo -e "${gray}Silakan reboot server Anda dengan 'enter'.${neutral}"
    echo -e "${blue}─────────────────────────────────────────${neutral}"
    read -p "Tekan enter untuk reboot server..."
    reboot
}

# Run main function with all arguments
main "$@"
