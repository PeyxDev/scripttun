/*
 * ws - Minimal WebSocket-to-local-service TCP proxy
 * Used to tunnel SSH / Dropbear / OpenVPN traffic wrapped as a
 * WebSocket (WS) upgrade request, for use behind Nginx (plain WS)
 * or Nginx+TLS (WS/SSL), as used by PX Store.
 *
 * Usage: ws <listen_port>
 *
 * Client apps (HTTP Injector / KPN Tunnel / NPV Tunnel / etc.) send
 * an HTTP request with an "X-Real-Host: 127.0.0.1:<port>" header to
 * select which local service (ssh/dropbear/openvpn) to tunnel to.
 * If that header is absent, the first entry of DEFAULT_HOSTS is used.
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <strings.h>
#include <unistd.h>
#include <signal.h>
#include <errno.h>
#include <sys/types.h>
#include <sys/socket.h>
#include <sys/select.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <netdb.h>

#define BUFLEN 8192

static const char *RESPONSE =
    "HTTP/1.1 101 Switching Protocols\r\n"
    "Upgrade: websocket\r\n"
    "Connection: Upgrade\r\n"
    "Sec-WebSocket-Accept: foo\r\n\r\n";

/* Default local targets, tried in order when the client doesn't send
 * X-Real-Host. Matches this project's sshd (2222/2223) and dropbear
 * (109) ports, plus OpenVPN (1194). */
static const char *default_hosts[] = {
    "127.0.0.1:109",
    "127.0.0.1:2223",
    "127.0.0.1:2222",
    "127.0.0.1:1194",
    NULL
};

static void die(const char *msg) { perror(msg); exit(1); }

static int find_header(const char *buf, const char *name, char *out, size_t outlen) {
    char search[128];
    snprintf(search, sizeof(search), "%s:", name);
    const char *p = strcasestr(buf, search);
    if (!p) return 0;
    p += strlen(search);
    while (*p == ' ' || *p == '\t') p++;
    const char *end = strstr(p, "\r\n");
    if (!end) end = p + strlen(p);
    size_t len = (size_t)(end - p);
    if (len >= outlen) len = outlen - 1;
    memcpy(out, p, len);
    out[len] = '\0';
    return 1;
}

/* Numeric-only connect (no DNS/NSS): every target here is a loopback
 * IP:port for a local service, so we avoid getaddrinfo() entirely --
 * that keeps a statically-linked binary fully self-contained. */
static int connect_target(const char *hostport) {
    char host[256];
    int port;
    char copy[256];
    snprintf(copy, sizeof(copy), "%s", hostport);
    char *colon = strrchr(copy, ':');
    if (colon) {
        *colon = 0;
        snprintf(host, sizeof(host), "%s", copy);
        port = atoi(colon + 1);
    } else {
        snprintf(host, sizeof(host), "%s", copy);
        port = 22;
    }
    if (port <= 0 || port > 65535) return -1;

    struct sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_port = htons((uint16_t)port);
    if (inet_pton(AF_INET, host, &addr.sin_addr) != 1) {
        /* Not a numeric IPv4 literal -- refuse rather than risk NSS/DNS
         * lookups inside a static binary. */
        return -1;
    }

    int fd = socket(AF_INET, SOCK_STREAM, 0);
    if (fd < 0) return -1;
    if (connect(fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
        close(fd);
        return -1;
    }
    return fd;
}

static void relay(int a, int b) {
    char buf[BUFLEN];
    for (;;) {
        fd_set fds;
        FD_ZERO(&fds);
        FD_SET(a, &fds);
        FD_SET(b, &fds);
        int maxfd = a > b ? a : b;
        struct timeval tv = {120, 0};
        int r = select(maxfd + 1, &fds, NULL, NULL, &tv);
        if (r <= 0) break;
        if (FD_ISSET(a, &fds)) {
            ssize_t n = recv(a, buf, sizeof(buf), 0);
            if (n <= 0) break;
            if (send(b, buf, (size_t)n, 0) <= 0) break;
        }
        if (FD_ISSET(b, &fds)) {
            ssize_t n = recv(b, buf, sizeof(buf), 0);
            if (n <= 0) break;
            if (send(a, buf, (size_t)n, 0) <= 0) break;
        }
    }
}

static void handle_client(int client_fd) {
    char buf[BUFLEN];
    ssize_t n = recv(client_fd, buf, sizeof(buf) - 1, 0);
    if (n <= 0) { close(client_fd); return; }
    buf[n] = '\0';

    char real_host[256];
    char target[256];
    if (find_header(buf, "X-Real-Host", real_host, sizeof(real_host)) && real_host[0]) {
        snprintf(target, sizeof(target), "%s", real_host);
    } else {
        snprintf(target, sizeof(target), "%s", default_hosts[0]);
    }

    char split[16];
    if (find_header(buf, "X-Split", split, sizeof(split))) {
        recv(client_fd, buf, sizeof(buf) - 1, 0); /* discard padding line */
    }

    int target_fd = connect_target(target);
    if (target_fd < 0) {
        for (int i = 1; default_hosts[i] && target_fd < 0; i++) {
            target_fd = connect_target(default_hosts[i]);
        }
    }
    if (target_fd < 0) {
        const char *err = "HTTP/1.1 502 Bad Gateway\r\n\r\n";
        send(client_fd, err, strlen(err), 0);
        close(client_fd);
        return;
    }

    send(client_fd, RESPONSE, strlen(RESPONSE), 0);
    relay(client_fd, target_fd);
    close(target_fd);
    close(client_fd);
}

int main(int argc, char *argv[]) {
    int port = 10015;
    if (argc > 1) port = atoi(argv[1]);
    if (port <= 0 || port > 65535) {
        fprintf(stderr, "Usage: %s <port>\n", argv[0]);
        return 1;
    }

    signal(SIGCHLD, SIG_IGN);
    signal(SIGPIPE, SIG_IGN);

    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    if (server_fd < 0) die("socket");
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    struct sockaddr_in addr;
    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_addr.s_addr = INADDR_ANY;
    addr.sin_port = htons((uint16_t)port);

    if (bind(server_fd, (struct sockaddr *)&addr, sizeof(addr)) < 0) die("bind");
    if (listen(server_fd, 256) < 0) die("listen");

    fprintf(stderr, "ws proxy (PX Store) listening on 0.0.0.0:%d\n", port);

    for (;;) {
        struct sockaddr_in cli;
        socklen_t clilen = sizeof(cli);
        int client_fd = accept(server_fd, (struct sockaddr *)&cli, &clilen);
        if (client_fd < 0) {
            if (errno == EINTR) continue;
            continue;
        }
        pid_t pid = fork();
        if (pid == 0) {
            close(server_fd);
            handle_client(client_fd);
            exit(0);
        } else if (pid > 0) {
            close(client_fd);
        } else {
            close(client_fd);
        }
    }
    return 0;
}
